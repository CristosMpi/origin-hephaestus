# Trusted runner broker only, outside any checkout and test container.
RUNNER_TOKEN=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1
# Optional: read-only token for private repositories. Never use the write token here.
GITHUB_READ_TOKEN=
# Explicit allowlist; the broker refuses other repositories.
ALLOWED_REPOSITORIES=your-org/your-repository
PORT=9090
SANDBOX_IMAGE=hephaestus-checks:1
# Optional prebuilt dependencies: create a trusted image with dependencies under
# /opt/dependencies/node_modules; no dependency install runs on the host.
