# Worker local secrets: copy this file to .dev.vars (gitignored).
# Live deployments: set secrets with `npx wrangler secret put NAME`.
# Never commit or paste credential values into chat.
ADMIN_ACCESS_KEY=
# Public visitors need no credentials. Optional existing administrator identity:
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=your-access-application-audience
# ADMIN_EMAILS=admin@example.com
FEEDBACK_API_TOKEN=
RUNNER_URL=https://runner.example.com
RUNNER_TOKEN=
GITHUB_WRITE_TOKEN=

# Runner broker environment only; DO NOT set on the code container.
# See runner/.env.example. APP_MODE is configured in wrangler.jsonc.
